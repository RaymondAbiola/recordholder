# BSC mainnet, normal reads. Any public endpoint works.
BSC_RPC_URL=

# BSC mainnet with archive state. Required: reconstructing corporate action
# history needs historical eth_call and wide eth_getLogs ranges, and most
# public endpoints serve neither. See docs/devex-log.md.
BSC_ARCHIVE_RPC_URL=

# Binance developer API. Server side only, never exposed to a browser:
# requests are signed with HMAC-SHA256 over the secret.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Optional. Defaults to https://web3.binance.com/build
BINANCE_W3W_BASE_URL=
# Optional. Confirm the wallet balance endpoint path against the developer portal.
BINANCE_BALANCE_PATH=
# Confirmed against the live API and the published client docs: BSC is "56".
BINANCE_BSC_CHAIN_ID=56
